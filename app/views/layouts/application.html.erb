<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Multi-Tenant Survey Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body>
    <% if logged_in? %>
      <header class="navbar">
        <div style="display: flex; align-items: center; gap: 1.5rem;">
          <a href="<%= dashboard_path %>" class="nav-brand">
            📊 SurveyPlatform <span class="badge">SaaS</span>
          </a>
          <nav>
            <ul class="nav-links">
              <li><%= link_to "Dashboard", dashboard_path, class: "nav-link #{'active' if current_page?(dashboard_path) || current_page?(root_path)}" %></li>
              <li><%= link_to "Surveys", surveys_path, class: "nav-link #{'active' if current_page?(surveys_path)}" %></li>
              <li><%= link_to "+ Create Survey", new_survey_path, class: "nav-link #{'active' if current_page?(new_survey_path)}" %></li>
              <li><%= link_to "Analytics", analytics_path, class: "nav-link #{'active' if current_page?(analytics_path)}" %></li>
            </ul>
          </nav>
        </div>

        <div class="nav-tenant">
          <div class="tenant-pill" title="Current Tenant">
            🏢 <span><%= current_customer.name %></span>
          </div>
          <span style="color: var(--text-muted); font-size: 0.85rem;"><%= current_user.email %></span>
          <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-secondary btn-sm" %>
        </div>
      </header>
    <% end %>

    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="flash-messages">
        <% if flash[:notice].present? %>
          <div class="flash flash-notice">
            <span>✓ <%= flash[:notice] %></span>
          </div>
        <% end %>
        <% if flash[:alert].present? %>
          <div class="flash flash-alert">
            <span>⚠ <%= flash[:alert] %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
