<% content_for :title, "Login - SurveyPlatform" %>

<div class="container-narrow">
  <div class="card" style="box-shadow: var(--shadow-md); padding: 2.25rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-main);">Welcome Back</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.35rem;">Sign in to your customer tenant account</p>
    </div>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email Address", class: "form-label" %>
        <%= f.email_field :email, class: "form-control", placeholder: "admin@example.com", autofocus: true, required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <div style="margin-top: 1.75rem;">
        <%= f.submit "Log in", class: "btn btn-primary", style: "width: 100%; padding: 0.75rem; font-size: 1rem;" %>
      </div>
    <% end %>

    <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border); text-align: center; font-size: 0.85rem; color: var(--text-muted);">
      <p>Multi-Tenant B2B SaaS Application &bull; Secure Authentication</p>
    </div>
  </div>
</div>
