<% content_for :title, "#{@survey.title} - SurveyPlatform" %>

<div class="container">
  <div style="margin-bottom: 1.5rem;">
    <%= link_to "&larr; Back to Surveys".html_safe, surveys_path, style: "color: var(--text-muted); text-decoration: none; font-size: 0.9rem;" %>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; gap: 1rem; flex-wrap: wrap;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main);"><%= @survey.title %></h1>
        <span class="badge-status badge-<%= @survey.status %>"><%= @survey.status %></span>
      </div>
      <% if @survey.description.present? %>
        <p style="color: var(--text-muted); font-size: 1rem; max-width: 750px;"><%= @survey.description %></p>
      <% end %>
    </div>

    <div class="btn-group">
      <%= link_to "View Submissions (#{@submissions_count})", survey_submissions_path(@survey), class: "btn btn-primary" %>
      <%= link_to "Edit Survey", edit_survey_path(@survey), class: "btn btn-secondary" %>
      <% if @survey.draft? %>
        <%= button_to "Publish Survey", publish_survey_path(@survey), method: :post, class: "btn btn-success", data: { turbo_confirm: "Are you sure you want to publish this survey? It will become publicly available." } %>
      <% end %>
      <%= button_to "Delete Survey", survey_path(@survey), method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure you want to delete this survey and all associated answers?" } %>
    </div>
  </div>

  <% if @survey.published? %>
    <div class="card" style="background: #f0fdf4; border-color: #bbf7d0; padding: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span style="font-weight: 700; color: #166534; font-size: 0.95rem;">🌐 Public Survey URL</span>
          <div style="font-family: monospace; font-size: 0.95rem; color: #14532d; margin-top: 0.25rem;">
            <%= public_survey_url(@survey.public_token) %>
          </div>
          <div style="font-size: 0.8rem; color: #15803d; margin-top: 0.25rem;">
            Published on <%= @survey.published_at&.strftime("%B %d, %Y at %I:%M %p") %>
          </div>
        </div>
        <div class="btn-group">
          <%= link_to "Open Public Survey &nearr;".html_safe, public_survey_path(@survey.public_token), target: "_blank", class: "btn btn-success btn-sm" %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card" style="background: #fefce8; border-color: #fef08a; padding: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span style="font-weight: 700; color: #854d0e; font-size: 0.95rem;">🔒 Survey is currently in Draft</span>
          <p style="font-size: 0.85rem; color: #713f12; margin-top: 0.2rem;">
            Draft surveys are private and cannot receive public responses until published.
          </p>
        </div>
        <%= button_to "Publish Now", publish_survey_path(@survey), method: :post, class: "btn btn-success btn-sm", data: { turbo_confirm: "Publish this survey now?" } %>
      </div>
    </div>
  <% end %>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Survey Questions (<%= @questions.size %>)</h2>
      <%= link_to "+ Edit Questions", edit_survey_path(@survey), class: "btn btn-secondary btn-sm" %>
    </div>

    <% if @questions.any? %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% @questions.each do |question| %>
          <div style="border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem; background: #fafafa;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-weight: 700; color: #475569;">#<%= question.position %></span>
                <span style="font-weight: 600; font-size: 1rem; color: var(--text-main);"><%= question.question_text %></span>
                <% if question.required? %>
                  <span style="background: #fee2e2; color: #991b1b; font-size: 0.7rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 4px;">REQUIRED</span>
                <% end %>
              </div>
              <span style="font-size: 0.8rem; background: #f1f5f9; color: #475569; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; text-transform: uppercase;">
                <%= question.question_type.humanize %>
              </span>
            </div>

            <% if question.multiple_choice? %>
              <div style="margin-top: 0.75rem; padding-left: 1rem;">
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.35rem; font-weight: 600;">Options:</div>
                <ul style="list-style-type: disc; padding-left: 1.25rem; font-size: 0.9rem; color: #334155;">
                  <% question.question_options.each do |option| %>
                    <li><%= option.label %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>This survey doesn't have any questions yet.</p>
        <%= link_to "+ Add Questions", edit_survey_path(@survey), class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>
