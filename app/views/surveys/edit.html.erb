<% content_for :title, "Edit Survey - #{@survey.title}" %>

<div class="container">
  <div style="margin-bottom: 1.5rem;">
    <%= link_to "&larr; Back to Survey".html_safe, survey_path(@survey), style: "color: var(--text-muted); text-decoration: none; font-size: 0.9rem;" %>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin-top: 0.5rem;">Edit Survey</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;"><%= @survey.title %></p>
  </div>

  <%= render "form", survey: @survey %>
</div>
