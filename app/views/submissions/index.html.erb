<% content_for :title, "Submissions - #{@survey.title}" %>

<div class="container">
  <div style="margin-bottom: 1.5rem;">
    <%= link_to "&larr; Back to #{@survey.title}".html_safe, survey_path(@survey), style: "color: var(--text-muted); text-decoration: none; font-size: 0.9rem;" %>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
      <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-main);">Survey Responses</h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Submissions for: <strong><%= @survey.title %></strong> (<%= @pagy.count %> total)</p>
      </div>
      <% if @survey.published? %>
        <%= link_to "Open Public Survey", public_survey_path(@survey.public_token), target: "_blank", class: "btn btn-secondary btn-sm" %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <% if @pagy.count > 0 %>
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border); font-size: 0.85rem; color: var(--text-muted); background: #f8fafc;">
        <span class="pagination-summary">Showing <strong><%= @pagy.from %>&ndash;<%= @pagy.to %></strong> of <strong><%= @pagy.count %></strong> submissions</span>
        <% if @pagy.last > 1 %>
          <span class="pagination-page-indicator">Page <strong><%= @pagy.page %></strong> of <strong><%= @pagy.last %></strong></span>
        <% end %>
      </div>

      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Submitted At</th>
              <th>Answers Count</th>
              <th>Sample Answers Preview</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @submissions.each do |submission| %>
              <tr>
                <td><strong>#<%= submission.id %></strong></td>
                <td><%= submission.submitted_at.strftime("%b %d, %Y at %I:%M %p") %></td>
                <td><%= submission.answers.size %> answers</td>
                <td>
                  <div style="font-size: 0.85rem; color: var(--text-muted); max-width: 450px;">
                    <% preview_answers = submission.answers.first(2) %>
                    <% preview_answers.each do |ans| %>
                      <div><strong><%= ans.question.question_text.truncate(25) %>:</strong> <%= ans.display_value.presence || "—" %></div>
                    <% end %>
                    <% if submission.answers.size > 2 %>
                      <span style="font-size: 0.75rem; color: #94a3b8;">+ <%= submission.answers.size - 2 %> more</span>
                    <% end %>
                  </div>
                </td>
                <td>
                  <%= link_to "View Details &rarr;".html_safe, survey_submission_path(@survey, submission), class: "btn btn-primary btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.last > 1 %>
        <nav class="pagination-bar" aria-label="Submissions pagination" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-top: 1px solid var(--border); background: #f8fafc;">
          <div>
            <% if @pagy.previous %>
              <%= link_to "&larr; Previous".html_safe, survey_submissions_path(@survey, page: @pagy.previous), class: "btn btn-secondary btn-sm pagination-prev" %>
            <% else %>
              <span class="btn btn-secondary btn-sm disabled pagination-prev-disabled" style="opacity: 0.5; pointer-events: none;">&larr; Previous</span>
            <% end %>
          </div>

          <div style="display: flex; gap: 0.35rem; align-items: center;" class="pagination-pages">
            <% (1..@pagy.last).each do |p_num| %>
              <% if p_num == @pagy.page %>
                <span class="btn btn-primary btn-sm pagination-current" style="pointer-events: none;"><%= p_num %></span>
              <% else %>
                <%= link_to p_num.to_s, survey_submissions_path(@survey, page: p_num), class: "btn btn-secondary btn-sm pagination-page" %>
              <% end %>
            <% end %>
          </div>

          <div>
            <% if @pagy.next %>
              <%= link_to "Next &rarr;".html_safe, survey_submissions_path(@survey, page: @pagy.next), class: "btn btn-secondary btn-sm pagination-next" %>
            <% else %>
              <span class="btn btn-secondary btn-sm disabled pagination-next-disabled" style="opacity: 0.5; pointer-events: none;">Next &rarr;</span>
            <% end %>
          </div>
        </nav>
      <% end %>

    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">📥</div>
        <h3>No responses yet</h3>
        <p>This survey has not received any submissions yet.</p>
        <% if @survey.published? %>
          <p>Share your public survey link to collect responses:</p>
          <div style="font-family: monospace; font-size: 0.9rem; margin-bottom: 1rem; color: var(--primary);">
            <%= public_survey_url(@survey.public_token) %>
          </div>
          <%= link_to "Visit Public Survey", public_survey_path(@survey.public_token), target: "_blank", class: "btn btn-primary btn-sm" %>
        <% else %>
          <%= button_to "Publish Survey Now", publish_survey_path(@survey), method: :post, class: "btn btn-success btn-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
